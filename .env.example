PORT=3000

# Google Cloud project ID — used to verify Identity Platform JWTs
# (issuer: https://securetoken.google.com/<GCP_PROJECT_ID>, audience: <GCP_PROJECT_ID>)
GCP_PROJECT_ID=your-gcp-project-id

# Public base URI of this server (used in receipts)
REPO_URI=https://your-domain.com

# Secret for signing receipts — use a long random string in production
RECEIPT_SECRET=change-me-to-a-long-random-secret

# Max size of a directly-uploaded asset (bytes) — default 50 MB
MAX_UPLOAD_SIZE=52428800

# Max size of an asset downloaded via byReference (bytes) — default 100 MB
MAX_REFERENCE_SIZE=104857600

# ---------------------------------------------------------------------------
# Storage plugins
#
# DATASTORE_PLUGIN and OBJECTSTORE_PLUGIN select the npm package used to
# persist manifests/bindings and binary assets, respectively. Install the
# desired plugin package as a dependency and point these at its name.
# ---------------------------------------------------------------------------

# DATASTORE_PLUGIN=@cognitiveproof/softbinding-api-plugin-mongodb
# OBJECTSTORE_PLUGIN=@cognitiveproof/softbinding-api-plugin-gcp-bucket

# --- @cognitiveproof/softbinding-api-plugin-mongodb ---
# MongoDB connection string
MONGO_DB_URI=mongodb://localhost:27017/c2pa

# --- @cognitiveproof/softbinding-api-plugin-sqlite ---
# Path to the SQLite database file (use ":memory:" for ephemeral storage)
SQLITE_DB_PATH=./data/softbinding.sqlite

# --- @cognitiveproof/softbinding-api-plugin-postgres ---
# PostgreSQL connection string
POSTGRES_URL=postgres://user:password@localhost:5432/c2pa

# --- @cognitiveproof/softbinding-api-plugin-mysql ---
# MySQL connection string
MYSQL_URL=mysql://user:password@localhost:3306/c2pa

# --- @cognitiveproof/softbinding-api-plugin-gcp-bucket ---
# Google Cloud Storage bucket names
DATA_BUCKET_NAME=your-data-bucket
PUBLIC_BUCKET_NAME=your-public-bucket

# Optional: service account JSON string for GCS access.
# If omitted, Application Default Credentials are used.
# GOOGLE_BUCKET_CREDENTIAL={"type":"service_account","project_id":"..."}

# --- @cognitiveproof/softbinding-api-plugin-aws-bucket ---
# AWS S3 bucket names
# DATA_BUCKET_NAME=your-data-bucket
# PUBLIC_BUCKET_NAME=your-public-bucket

# AWS region (default: us-east-1)
# AWS_REGION=us-east-1

# Credentials are resolved via the standard AWS SDK credential chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN env vars,
# shared config files, EC2/ECS/Lambda instance roles, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: custom S3-compatible endpoint (e.g. MinIO, Cloudflare R2, DigitalOcean Spaces)
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true
