{
  "name": "@cognitiveproof/softbinding-api-server",
  "version": "1.1.0",
  "description": "C2PA Soft Binding Resolution API v2.4 server implementation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cognitive-Proof/c2pa-soft-binding-server.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "softbinding-api-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "workspaces": [
    "plugins/*",
    "conformance"
  ],
  "scripts": {
    "build": "npm run build -w @cognitiveproof/softbinding-api-plugin-types && npm run build -w @cognitiveproof/softbinding-api-plugin-mongodb -w @cognitiveproof/softbinding-api-plugin-gcp-bucket -w @cognitiveproof/softbinding-api-plugin-aws-bucket -w @cognitiveproof/softbinding-api-plugin-sqlite -w @cognitiveproof/softbinding-api-plugin-postgres -w @cognitiveproof/softbinding-api-plugin-mysql -w @cognitiveproof/softbinding-api-plugin-google-auth -w @cognitiveproof/softbinding-api-plugin-pino-logger -w @cognitiveproof/softbinding-api-plugin-redis-rate-limit -w @cognitiveproof/softbinding-api-plugin-vsmark && tsc",
    "typecheck": "npm run build -w @cognitiveproof/softbinding-api-plugin-types && npm run typecheck --workspaces --if-present && tsc --noEmit && tsc -p tsconfig.jest.json",
    "start": "node dist/cli.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/cli.ts",
    "upload:manifest": "ts-node scripts/uploadFile.ts",
    "check:auth": "ts-node scripts/checkAuthToken.ts",
    "publish:root": "ts-node scripts/publishRootIfChanged.ts",
    "test": "jest && npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish && npm run publish:root"
  },
  "dependencies": {
    "@cognitiveproof/softbinding-api-plugin-types": "^1.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jose": "^6.2.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@cognitiveproof/softbinding-api-plugin-aws-bucket": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-gcp-bucket": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-google-auth": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-mongodb": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-mysql": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-pino-logger": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-postgres": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-redis-rate-limit": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-sqlite": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-vsmark": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@cognitiveproof/softbinding-api-plugin-aws-bucket": {
      "optional": true
    },
    "@cognitiveproof/softbinding-api-plugin-gcp-bucket": {
      "optional": true
    },
    "@cognitiveproof/softbinding-api-plugin-google-auth": {
      "optional": true
    },
    "@cognitiveproof/softbinding-api-plugin-mongodb": {
      "optional": true
    },
    "@cognitiveproof/softbinding-api-plugin-mysql": {
      "optional": true
    },
    "@cognitiveproof/softbinding-api-plugin-pino-logger": {
      "optional": true
    },
    "@cognitiveproof/softbinding-api-plugin-postgres": {
      "optional": true
    },
    "@cognitiveproof/softbinding-api-plugin-redis-rate-limit": {
      "optional": true
    },
    "@cognitiveproof/softbinding-api-plugin-sqlite": {
      "optional": true
    },
    "@cognitiveproof/softbinding-api-plugin-vsmark": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "babel-jest": "^30.4.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.61.0"
  }
}
