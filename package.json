{
  "name": "@cognitiveproof/softbinding-api-server",
  "version": "1.0.0",
  "description": "C2PA Soft Binding Resolution API v2.3.0 server implementation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "softbinding-api-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "npm run build -w @cognitiveproof/softbinding-api-plugin-types && npm run build -w @cognitiveproof/softbinding-api-plugin-mongodb -w @cognitiveproof/softbinding-api-plugin-gcp-bucket -w @cognitiveproof/softbinding-api-plugin-aws-bucket -w @cognitiveproof/softbinding-api-plugin-sqlite -w @cognitiveproof/softbinding-api-plugin-postgres -w @cognitiveproof/softbinding-api-plugin-mysql -w @cognitiveproof/softbinding-api-plugin-google-auth && tsc",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "start": "node dist/cli.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/cli.ts",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@cognitiveproof/softbinding-api-plugin-types": "^1.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jose": "^6.2.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@cognitiveproof/softbinding-api-plugin-aws-bucket": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-gcp-bucket": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-google-auth": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-mongodb": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-mysql": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-postgres": "^1.0.0",
    "@cognitiveproof/softbinding-api-plugin-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
