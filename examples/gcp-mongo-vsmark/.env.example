PORT=3000

# Public base URI of this server (used in receipts)
REPO_URI=https://your-domain.com

# Secret for signing receipts — use a long random string in production
RECEIPT_SECRET=change-me-to-a-long-random-secret

# --- @cognitiveproof/softbinding-api-plugin-google-auth ---
# Google Cloud project ID — used to verify Identity Platform JWTs
GCP_PROJECT_ID=your-gcp-project-id

# --- @cognitiveproof/softbinding-api-plugin-mongodb ---
MONGO_DB_URI=mongodb://localhost:27017/c2pa

# --- @cognitiveproof/softbinding-api-plugin-gcp-bucket ---
DATA_BUCKET_NAME=your-data-bucket
PUBLIC_BUCKET_NAME=your-public-bucket

# Optional: service account JSON string for GCS access.
# If omitted, Application Default Credentials are used.
# GOOGLE_BUCKET_CREDENTIAL={"type":"service_account","project_id":"..."}

# --- @cognitiveproof/softbinding-api-plugin-pino-logger ---
# LOG_LEVEL=info
